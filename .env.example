# Copie para .env e troque os valores: cp .env.example .env

# Configuração do postgres
PG_USER=lab_eda
PG_PASSWORD=troque_aqui
PG_DB=lab_eda_kafka

# Configuração PGADMIN (o email precisa ter formato válido)
PGADMIN_EMAIL=admin@exemplo.com
PGADMIN_PASSWORD=troque_aqui

# Configuração MinIO (senhas com no mínimo 8 caracteres)
MINIO_USER=lab_eda
MINIO_PASSWORD=troque_aqui
# Access Key criada no console do MinIO para o conector Sink
MINIO_ACCESS_KEY=troque_aqui
MINIO_SECRET_KEY=troque_aqui

# Configuração Kafka UI
KAFKA_UI_USER=lab_eda
KAFKA_UI_PASSWORD=troque_aqui
